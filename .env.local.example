# Set this to your Vercel deployment URL in production, or leave it empty to use same-origin /api routes.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blockchain / Hardhat
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
POLYGON_AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_KEY
ADMIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=0xYourDeployedContractAddress
NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Database for Vercel deployment
# Use a persistent hosted Postgres database in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

# Razorpay onramp
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_TOKENS_PER_INR=10
RAZORPAY_BASE_URL=https://api.razorpay.com

# SMTP configuration for confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com
